{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "photo-renamer-nextjs",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".next"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "photo-renamer-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}
